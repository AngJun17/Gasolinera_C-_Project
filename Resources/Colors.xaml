<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fondos -->
    <SolidColorBrush x:Key="BrushFondoApp"       Color="#1A1A2E"/>
    <SolidColorBrush x:Key="BrushFondoPanel"     Color="#16213E"/>
    <SolidColorBrush x:Key="BrushFondoInput"     Color="#0F3460"/>
    <SolidColorBrush x:Key="BrushBorde"          Color="#0F3460"/>
    <SolidColorBrush x:Key="BrushBordeInput"     Color="#1A3A5C"/>

    <!-- Texto -->
    <SolidColorBrush x:Key="BrushTexto"          Color="#EEEEEE"/>
    <SolidColorBrush x:Key="BrushTextoSecun"     Color="#8892A4"/>
    <SolidColorBrush x:Key="BrushTextoDim"       Color="#CCCCCC"/>

    <!-- Acento rojo-rosa -->
    <SolidColorBrush x:Key="BrushAcento"         Color="#E94560"/>

    <!-- Estados bomba -->
    <SolidColorBrush x:Key="BrushVerde"          Color="#27C93F"/>
    <SolidColorBrush x:Key="BrushVerdeOscuro"    Color="#0D3B26"/>
    <SolidColorBrush x:Key="BrushRojoOscuro"     Color="#3B0D1A"/>
    <SolidColorBrush x:Key="BrushAzulProgreso"   Color="#457FCA"/>

</ResourceDictionary>
