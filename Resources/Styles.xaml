<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!--TEXTOS -->

    <Style TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource BrushTexto}"/>
        <Setter Property="FontFamily"  Value="Segoe UI"/>
        <Setter Property="FontSize"    Value="12"/>
    </Style>

    <Style x:Key="TextoSeccion" TargetType="TextBlock">
        <Setter Property="Foreground"       Value="{StaticResource BrushTextoSecun}"/>
        <Setter Property="FontSize"         Value="10"/>
        <Setter Property="FontFamily"       Value="Segoe UI"/>
        <Setter Property="Margin"           Value="0,0,0,6"/>
    </Style>

    <Style x:Key="TextoLabel" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource BrushTextoSecun}"/>
        <Setter Property="FontSize"    Value="10"/>
        <Setter Property="FontFamily"  Value="Segoe UI"/>
        <Setter Property="Margin"      Value="0,0,0,3"/>
    </Style>

    <!-- INPUTS -->

    <Style TargetType="TextBox">
        <Setter Property="Background"       Value="{StaticResource BrushFondoInput}"/>
        <Setter Property="Foreground"       Value="{StaticResource BrushTexto}"/>
        <Setter Property="BorderBrush"      Value="{StaticResource BrushBordeInput}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="Padding"          Value="8,5"/>
        <Setter Property="FontSize"         Value="11"/>
        <Setter Property="FontFamily"       Value="Segoe UI"/>
        <Setter Property="CaretBrush"       Value="{StaticResource BrushTexto}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background"       Value="{StaticResource BrushFondoInput}"/>
        <Setter Property="Foreground"       Value="{StaticResource BrushTexto}"/>
        <Setter Property="BorderBrush"      Value="{StaticResource BrushBordeInput}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="Padding"          Value="8,5"/>
        <Setter Property="FontSize"         Value="11"/>
        <Setter Property="FontFamily"       Value="Segoe UI"/>
        <Setter Property="Height"           Value="28"/>
    </Style>

    <!-- BOTONES\-->

    <!-- Botón primario rojo -->
    <Style x:Key="BtnPrimario" TargetType="Button">
        <Setter Property="Background"       Value="{StaticResource BrushAcento}"/>
        <Setter Property="Foreground"       Value="White"/>
        <Setter Property="FontWeight"       Value="Medium"/>
        <Setter Property="FontSize"         Value="11"/>
        <Setter Property="FontFamily"       Value="Segoe UI"/>
        <Setter Property="Padding"          Value="14,5"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#C73650"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#2A2A3E"/>
                            <Setter Property="Foreground" Value="#555"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón secundario azul oscuro -->
    <Style x:Key="BtnSecundario" TargetType="Button">
        <Setter Property="Background"       Value="{StaticResource BrushFondoInput}"/>
        <Setter Property="Foreground"       Value="{StaticResource BrushTextoSecun}"/>
        <Setter Property="FontSize"         Value="11"/>
        <Setter Property="FontFamily"       Value="Segoe UI"/>
        <Setter Property="Padding"          Value="14,5"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1A3A5C"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón nav sidebar normal -->
    <Style x:Key="BtnNav" TargetType="Button">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Foreground"       Value="{StaticResource BrushTextoSecun}"/>
        <Setter Property="FontSize"         Value="12"/>
        <Setter Property="FontFamily"       Value="Segoe UI"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding"          Value="10,8"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="borde" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="Background" Value="#0F3460"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTexto}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botón nav sidebar ACTIVO -->
    <Style x:Key="BtnNavActivo" TargetType="Button" BasedOn="{StaticResource BtnNav}">
        <Setter Property="Background"  Value="{StaticResource BrushAcento}"/>
        <Setter Property="Foreground"  Value="White"/>
    </Style>

</ResourceDictionary>
