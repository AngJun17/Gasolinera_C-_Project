<UserControl x:Class="GasoStation.Views.CierreCajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:GasoStation.Views"
             mc:Ignorable="d"
             Height="450" Width="800">
    <StackPanel Margin="16,16,16,16">
        <TextBlock Text="CIERRE DE CAJA DIARIO" Style="{StaticResource TextoSeccion}"/>

        <!-- Selector de fecha -->
        <Border Background="{StaticResource BrushFondoPanel}" CornerRadius="10"
                BorderBrush="{StaticResource BrushBorde}" BorderThickness="1"
                Padding="14,12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Fecha:" Style="{StaticResource TextoLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding FechaCierre}"
                            Background="{StaticResource BrushFondoInput}"
                            Foreground="{StaticResource BrushTexto}"
                            Width="160"/>
                <Button Content="Generar cierre" Style="{StaticResource BtnPrimario}"
                        Command="{Binding GenerarCierreCommand}" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Resumen cierre -->
        <UniformGrid Columns="3" Margin="0,0,0,12">
            <Border Margin="0,0,5,0" Padding="12,10" CornerRadius="8"
                    Background="{StaticResource BrushFondoPanel}"
                    BorderBrush="{StaticResource BrushBorde}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Total recaudado" Style="{StaticResource TextoLabel}"/>
                    <TextBlock Text="{Binding CierreTotalMonto, StringFormat='Q {0:N2}'}"
                               FontSize="20" FontWeight="Medium" Foreground="#27C93F"/>
                </StackPanel>
            </Border>
            <Border Margin="5,0,5,0" Padding="12,10" CornerRadius="8"
                    Background="{StaticResource BrushFondoPanel}"
                    BorderBrush="{StaticResource BrushBorde}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Total servicios" Style="{StaticResource TextoLabel}"/>
                    <TextBlock Text="{Binding CierreTotalServicios}"
                               FontSize="20" FontWeight="Medium" Foreground="{StaticResource BrushTexto}"/>
                </StackPanel>
            </Border>
            <Border Margin="5,0,0,0" Padding="12,10" CornerRadius="8"
                    Background="{StaticResource BrushFondoPanel}"
                    BorderBrush="{StaticResource BrushBorde}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Total litros" Style="{StaticResource TextoLabel}"/>
                    <TextBlock Text="{Binding CierreTotalLitros, StringFormat='{}{0:F2} L'}"
                               FontSize="20" FontWeight="Medium" Foreground="{StaticResource BrushAcento}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Tabla detalle -->
        <Border Background="{StaticResource BrushFondoPanel}" CornerRadius="10"
                BorderBrush="{StaticResource BrushBorde}" BorderThickness="1">
            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Header moved out of ItemsControl because ItemsControl has no Header property -->
                    <Grid Margin="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Cliente"   Style="{StaticResource TextoLabel}"/>
                        <TextBlock Grid.Column="1" Text="Bomba"     Style="{StaticResource TextoLabel}"/>
                        <TextBlock Grid.Column="2" Text="Tipo"      Style="{StaticResource TextoLabel}"/>
                        <TextBlock Grid.Column="3" Text="Litros"    Style="{StaticResource TextoLabel}"/>
                        <TextBlock Grid.Column="4" Text="Monto"     Style="{StaticResource TextoLabel}"/>
                        <TextBlock Grid.Column="5" Text="Hora"      Style="{StaticResource TextoLabel}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding CierreDetalle}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BrushBorde}" BorderThickness="0,1,0,0" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Cliente}" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding BombaId, StringFormat='B{0}'}" FontSize="11" Foreground="{StaticResource BrushTextoSecun}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Tipo, Converter={StaticResource TipoConv}}" FontSize="11"/>
                                        <TextBlock Grid.Column="3" Text="{Binding LitrosServidos, StringFormat='{}{0:F2} L'}" FontSize="11"/>
                                        <TextBlock Grid.Column="4" Text="{Binding MontoFinal, StringFormat='Q {0:F2}'}" FontSize="11" Foreground="#27C93F"/>
                                        <TextBlock Grid.Column="5" Text="{Binding FechaHora, StringFormat='HH:mm'}" FontSize="11" Foreground="{StaticResource BrushTextoSecun}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </StackPanel>
</UserControl>
