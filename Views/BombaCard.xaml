<UserControl x:Class="GasoStation.Views.BombaCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border CornerRadius="10" Padding="12,12"
            Background="{StaticResource BrushFondoPanel}"
            BorderThickness="1"
            BorderBrush="{Binding Estado, Converter={StaticResource BorderConv}}">
        <StackPanel>

            <!-- Header: nombre + badge -->
            <Grid Margin="0,0,0,8">
                <TextBlock Text="{Binding NombreBomba}"
                           FontSize="13" FontWeight="Medium"
                           Foreground="{StaticResource BrushTexto}"
                           VerticalAlignment="Center"/>

                <!-- Badge LIBRE -->
                <Border HorizontalAlignment="Right" CornerRadius="99" Padding="8,2"
                        Background="{StaticResource BrushVerdeOscuro}"
                        Visibility="{Binding EstaLibre, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="Libre" FontSize="10" FontWeight="Medium"
                               Foreground="{StaticResource BrushVerde}"/>
                </Border>

                <!-- Badge ACTIVA con actualizacion de estado -->
                <Border HorizontalAlignment="Right" CornerRadius="99" Padding="8,2"
                        Background="{StaticResource BrushRojoOscuro}"
                        Visibility="{Binding EstaActiva, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Margin="0,0,5,0"
                                 Fill="{StaticResource BrushAcento}">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="Opacity"
                                                From="1" To="0.2" Duration="0:0:0.6"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Text="Activa" FontSize="10" FontWeight="Medium"
                                   Foreground="{StaticResource BrushAcento}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Icono bomba SVG -->
            <Grid Height="54" Margin="0,0,0,8">
                <Canvas Width="44" Height="44"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Cuerpo -->
                    <Rectangle Canvas.Left="8" Canvas.Top="10"
                               Width="18" Height="26" RadiusX="3" RadiusY="3"
                               Fill="Transparent" StrokeThickness="1.5"
                               Stroke="{Binding Estado, Converter={StaticResource NumColorConv}}"/>
                    <!-- Pantallita -->
                    <Rectangle Canvas.Left="10" Canvas.Top="12"
                               Width="14" Height="10" RadiusX="1.5" RadiusY="1.5"
                               StrokeThickness="0" Opacity="0.2"
                               Fill="{Binding Estado, Converter={StaticResource NumColorConv}}"/>
                    <!-- Manguera -->
                    <Line X1="26" Y1="20" X2="34" Y2="20" StrokeThickness="1.5"
                          Stroke="{Binding Estado, Converter={StaticResource NumColorConv}}"/>
                    <!-- Punta -->
                    <Ellipse Canvas.Left="31" Canvas.Top="17" Width="6" Height="6"
                             StrokeThickness="1.5"
                             Stroke="{Binding Estado, Converter={StaticResource NumColorConv}}"
                             Fill="Transparent"/>
                    <!-- Base -->
                    <Rectangle Canvas.Left="14" Canvas.Top="30"
                               Width="6" Height="6" RadiusX="1" RadiusY="1"
                               Opacity="0.4"
                               Fill="{Binding Estado, Converter={StaticResource NumColorConv}}"/>
                </Canvas>
            </Grid>

            <!-- Info bomba LIBRE -->
            <StackPanel Margin="0,0,0,8"
                        Visibility="{Binding EstaLibre, Converter={StaticResource BoolVis}}">
                <Grid Margin="0,0,0,2">
                    <TextBlock Text="Total abastec." FontSize="11"
                               Foreground="{StaticResource BrushTextoSecun}"/>
                    <TextBlock Text="{Binding TotalServicios, StringFormat='{}{0} servicios'}"
                               FontSize="11" FontWeight="Medium"
                               Foreground="{StaticResource BrushTextoDim}"
                               HorizontalAlignment="Right"/>
                </Grid>
                <Grid>
                    <TextBlock Text="Último cliente" FontSize="11"
                               Foreground="{StaticResource BrushTextoSecun}"/>
                    <TextBlock Text="{Binding UltimoCliente}"
                               FontSize="11" FontWeight="Medium"
                               Foreground="{StaticResource BrushTextoDim}"
                               HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>

            <!-- Info bomba activa -->
            <StackPanel Margin="0,0,0,8"
                        Visibility="{Binding EstaActiva, Converter={StaticResource BoolVis}}">
                <Grid Margin="0,0,0,2">
                    <TextBlock Text="Cliente" FontSize="11"
                               Foreground="{StaticResource BrushTextoSecun}"/>
                    <TextBlock Text="{Binding ClienteActual}"
                               FontSize="11" FontWeight="Medium"
                               Foreground="{StaticResource BrushTextoDim}"
                               HorizontalAlignment="Right"/>
                </Grid>
                <Grid>
                    <TextBlock Text="Tipo" FontSize="11"
                               Foreground="{StaticResource BrushTextoSecun}"/>
                    <TextBlock Text="{Binding EtiquetaTipo}"
                               FontSize="11" FontWeight="Medium"
                               Foreground="{StaticResource BrushTextoDim}"
                               HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>

            <!-- Barra de progreso -->
            <Border Height="4" CornerRadius="2"
                    Background="{StaticResource BrushFondoInput}"
                    ClipToBounds="True">
                <Border HorizontalAlignment="Left" CornerRadius="2"
                        Width="{Binding AnchoBarraProgreso}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#27C93F" Offset="0"/>
                            <GradientStop Color="#5EFF7A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Border>

        </StackPanel>
    </Border>
</UserControl>
